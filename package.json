{
  "name": "harness-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Static checker for LLM-generated Scheme and TypeScript tool-calling programs",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./ts/dist/index.d.ts",
      "default": "./ts/dist/index.js"
    },
    "./ai-sdk": {
      "types": "./ts/dist/ai-sdk.d.ts",
      "default": "./ts/dist/ai-sdk.js"
    }
  },
  "bin": {
    "harness-checker-ts": "ts/dist/cli.js"
  },
  "files": [
    "ts/dist",
    "data/ts-safe.d.ts",
    "data/bash-safe.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "tsc -p ts/tsconfig.build.json",
    "test:ts": "node --test \"ts/test/**/*.test.ts\"",
    "typecheck:ts": "tsc -p ts"
  },
  "dependencies": {
    "quickjs-emscripten": "0.32.0",
    "sh-syntax": "0.8.2",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "ai": "^7.0.159",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "ai": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  }
}
