(import (chezscheme))
;; Every program source test-termination.ss hands check-source-termination or assert-rejected,
;; one per line, as a written string.
(define (src x)
  (cond ((string? x) x)
        ((and (pair? x) (eq? (car x) 'string-append) (for-all string? (cdr x)))
         (apply string-append (cdr x)))
        (else #f)))
(define out '())
(define (walk x)
  (when (pair? x)
    (cond ((and (eq? (car x) 'check-source-termination) (pair? (cdr x)) (src (cadr x)))
           => (lambda (s) (set! out (cons s out))))
          ((and (eq? (car x) 'assert-rejected) (= (length x) 3) (src (caddr x)))
           => (lambda (s) (set! out (cons s out)))))
    (when (list? x) (for-each walk x))))
(let ((p (open-input-file (cadr (command-line)))))
  (let loop () (let ((f (read p))) (unless (eof-object? f) (walk f) (loop)))))
(for-each (lambda (s) (write s) (newline)) (reverse out))
