;; Writes ts/src/termination/chezenv.ts: every symbol termination.ss's misread-name? reads as a Chez
;; builtin or keyword, i.e. top-level-bound? or top-level-syntax? in (scheme-environment).
(import (chezscheme))
(define env (scheme-environment))
(define names
  (list-sort string<?
    (map symbol->string
      (filter (lambda (s) (or (top-level-bound? s env) (top-level-syntax? s env)))
              (environment-symbols env)))))
(define (js-string s)
  (call-with-string-output-port
    (lambda (p)
      (put-char p #\")
      (string-for-each
        (lambda (c) (when (memv c '(#\" #\\)) (put-char p #\\)) (put-char p c))
        s)
      (put-char p #\"))))
(display "// Generated by ts/test/differential/regen-chezenv.sh from Chez's (scheme-environment). Do not edit.\n")
(display "// termination.ss:2960 misread-name?: names the analysis would read as a Chez builtin or keyword.\n\n")
(display "export const CHEZ_VERSION = ")
(display (js-string (call-with-values scheme-version-number
                      (lambda (a b c) (format "~a.~a.~a" a b c)))))
(display ";\n\nconst NAMES: ReadonlySet<string> = new Set([\n")
(for-each (lambda (n) (display "  ") (display (js-string n)) (display ",\n")) names)
(display "]);\n\nexport function isChezSchemeName(name: string): boolean {\n  return NAMES.has(name);\n}\n")
